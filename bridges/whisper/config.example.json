{
  "broker": "127.0.0.1",
  "port": 1883,
  "topic": "whisper/transcript",
  "chunks_dir": "/data/spectra/audio-capture/chunks",
  "transcripts_dir": "/data/spectra/audio-capture/transcripts",
  "engine": "cpu",
  "model": "base",
  "language": "auto",
  "translate_engine": "whisper",
  "target_language": "en",
  "task": "transcribe",
  "compute_type": "int8",
  "mqtt_ttl": 30,
  "text_color": [255, 255, 255],
  "poll_seconds": 2,
  "vad_filter": true,
  "no_speech_threshold": 0.65,
  "min_words": 2,
  "min_chars": 4,
  "max_no_speech_prob": 0.55,
  "min_avg_logprob": -0.75,
  "translate_skip_logprob": true,
  "min_avg_logprob_translate": -2.0,
  "max_no_speech_prob_translate": 0.72
}
