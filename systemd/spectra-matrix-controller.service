[Unit]
Description=Spectra matrix controller (web UI + display modes)
Documentation=https://github.com/kaerka/spectra-led-matrix
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/spectra-led-matrix
ExecStart=/opt/spectra-led-matrix/.venv/bin/python /opt/spectra-led-matrix/run.py
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/spectra-led-matrix/rpi-rgb-led-matrix/bindings/python
Environment=SPECTRA_MATRIX_USER=spectra
Environment=MATRIX_WEB_HOST=0.0.0.0
Environment=MATRIX_WEB_PORT=8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# --- Install (example paths — adjust to your checkout) --------------------
#   sudo cp systemd/spectra-matrix-controller.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now spectra-matrix-controller
#   journalctl -u spectra-matrix-controller -f
#
# Prefer the Ansible-templated unit under /data/spectra/repos/spectra-led-matrix
# after a matrix-pis deploy. Per-host overrides:
#   sudo systemctl edit spectra-matrix-controller
