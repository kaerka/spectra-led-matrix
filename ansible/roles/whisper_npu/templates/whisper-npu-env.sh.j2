# {{ ansible_managed }}
# Runtime environment for whisper-npu-host; sourced by bridges/whisper/asr_npu.py.
# VoiceAI libraries from the SDK, QNN host libraries unpacked from qairt-libs
# {{ whisper_npu_qairt_version }} (must match the qairt-dsp-binaries skels on the DSP).
export LD_LIBRARY_PATH="{{ whisper_npu_sdk_dir }}/libs/npu/rpc_libraries/linux/whisper_all_quantized:{{ whisper_npu_qairt_dir }}/usr/lib:/usr/lib/aarch64-linux-gnu"
export ADSP_LIBRARY_PATH="/usr/lib/dsp/cdsp;/usr/lib/dsp"
