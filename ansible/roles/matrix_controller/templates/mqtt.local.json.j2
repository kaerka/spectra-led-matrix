{
  "broker": "{{ mqtt_broker_host }}",
  "port": 1883,
  "username": null,
  "password": null,
  "tls": false,
  "enabled": true,
  "topics": {{ (mqtt_wall_sources | default(['whisper', 'meshtastic', 'aether', 'iris', 'nightglass']) | map('extract', mqtt_source_defs) | map(attribute='topics') | flatten | unique | list) | to_json }},
  "client_id": "spectra-matrix-{{ inventory_hostname }}",
  "idle_seconds": 30,
  "text_color": [255, 255, 255],
  "text_font_size": 18,
  "fps": 15,
  "scroll_px_per_sec": 18,
  "max_text_chars": 400
}
